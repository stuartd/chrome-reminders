{
  "manifest_version": 3,
  "name": "Meeting Reminders",
  "version": "0.1.0",
  "description": "Meeting reminders 15 minutes before, 5 minutes before, and at the start. Quiet once you join Google Meet.",
  "minimum_chrome_version": "120",
  "permissions": [
    "alarms",
    "notifications",
    "storage",
    "identity"
  ],
  "host_permissions": [
    "https://www.googleapis.com/*",
    "https://meet.google.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Meeting Reminders",
    "default_popup": "app.html"
  },
  "options_page": "app.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "meet.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "key": ""
}
